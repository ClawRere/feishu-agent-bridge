# 复制为 .env 并填入你自己的值。绝不提交 .env 到仓库。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 机器人显示名（@提及 的名字兜底匹配）
BOT_NAME=你的机器人显示名

# 机器人在本应用下的 open_id（提及精确匹配，推荐配置；可留空只用名字匹配）
# BOT_OPEN_ID=ou_xxxxxxxxxxxxxxxx

# 只处理指定群聊；留空则任意群聊里的 @ 都处理
# TARGET_CHAT=oc_xxxxxxxxxxxxxxxx

# 提及转交队列与心跳文件路径
# QUEUE_PATH=./mention_queue.jsonl
# HEARTBEAT_PATH=./listener_heartbeat.txt

# 出网代理（如果需要；WebSocket 还需 docs/proxy.md 的 SDK patch）
# HTTPS_PROXY=http://your-proxy:3128
# HTTP_PROXY=http://your-proxy:3128
